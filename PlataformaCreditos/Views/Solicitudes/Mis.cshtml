@model List<PlataformaCreditos.Models.SolicitudCredito>
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<h2>Mis Solicitudes</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning">@ViewBag.Mensaje</div>
}

@if (ViewBag.Errores != null)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in (List<string>)ViewBag.Errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<form method="get" asp-action="Mis" class="row g-2 mb-4">
    <div class="col-auto">
        <label>Estado</label>
        <select name="estado" class="form-select">
            <option value="">-- Todos --</option>
            <option value="0" selected="@(ViewBag.Estado?.ToString() == "0")">Pendiente</option>
            <option value="1" selected="@(ViewBag.Estado?.ToString() == "1")">Aprobado</option>
            <option value="2" selected="@(ViewBag.Estado?.ToString() == "2")">Rechazado</option>
        </select>
    </div>
    <div class="col-auto">
        <label>Monto mínimo</label>
        <input type="number" step="0.01" name="montoMin" class="form-control" value="@ViewBag.MontoMin" />
    </div>
    <div class="col-auto">
        <label>Monto máximo</label>
        <input type="number" step="0.01" name="montoMax" class="form-control" value="@ViewBag.MontoMax" />
    </div>
    <div class="col-auto">
        <label>Desde</label>
        <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
    </div>
    <div class="col-auto">
        <label>Hasta</label>
        <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Monto</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr data-solicitud-id="@s.Id">
                <td>@s.Id</td>
                <td>@s.MontoSolicitado.ToString("C")</td>
                <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                <td id="estado-cell-@s.Id">@s.Estado</td>
                <td><a asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a></td>
            </tr>
        }
    </tbody>
</table>