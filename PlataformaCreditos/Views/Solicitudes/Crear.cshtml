@{
    ViewData["Title"] = "Registrar Solicitud";
}

<h2>Registrar Nueva Solicitud de Crédito</h2>

<p>Tus ingresos mensuales registrados: <strong>@(((decimal?)ViewBag.IngresosMensuales)?.ToString("C"))</strong></p>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post" asp-action="Crear">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Monto Solicitado</label>
        <input type="number" step="0.01" name="montoSolicitado" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
    <a asp-action="Mis" class="btn btn-secondary">Cancelar</a>
</form>